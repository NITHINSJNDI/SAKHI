NEXTAUTH_URL=http://localhost:3000
# REQUIRED in production (generate with: openssl rand -base64 32).
# Without it NextAuth refuses to start in production; dev uses an insecure placeholder.
NEXTAUTH_SECRET=your_nextauth_secret_here

# ==============================================================================
# GEMINI API KEYS (POOLED & ROTATING)
# Supports:
# 1. Single primary key: GEMINI_API_KEY
# 2. Comma-separated pool: GEMINI_API_KEYS=key1,key2,key3...
# 3. Numbered keys: GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc.
# When any key hits a quota or rate limit, the system automatically falls over to the next key.
# With no key at all (or every key exhausted) Sakhi switches to its offline rule-based chat engine.
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY_1=your_first_gemini_key
GEMINI_API_KEY_2=your_second_gemini_key

# ==============================================================================
# ML SERVICE & BACKEND
# ==============================================================================
# Server-side URL of the FastAPI ML service. If it is unreachable, the Next.js app
# scores with the identical in-process TypeScript models (lib/ml/scoring.ts).
ML_SERVICE_URL=http://127.0.0.1:8000

# ==============================================================================
# GOOGLE OAUTH CREDENTIALS
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==============================================================================
# SUPABASE / POSTGRESQL DATABASE
# ==============================================================================
DATABASE_URL=postgresql://user:password@host:port/dbname
# Without DATABASE_URL, data is kept in a local JSON file (.data/sakhi-store.json,
# override with SAKHI_DATA_DIR) or, on serverless hosts, in size-limited cookies.
# SAKHI_DATA_DIR=.data
