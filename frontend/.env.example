NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# ==============================================================================
# GEMINI API KEYS (POOLED & ROTATING)
# Supports:
# 1. Single primary key: GEMINI_API_KEY
# 2. Comma-separated pool: GEMINI_API_KEYS=key1,key2,key3...
# 3. Numbered keys: GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc.
# When any key hits a quota or rate limit, the system automatically falls over to the next key.
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY_1=your_first_gemini_key
GEMINI_API_KEY_2=your_second_gemini_key

# ==============================================================================
# ML SERVICE & BACKEND
# ==============================================================================
NEXT_PUBLIC_ML_BACKEND_URL=http://127.0.0.1:8000

# ==============================================================================
# GOOGLE OAUTH CREDENTIALS
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==============================================================================
# SUPABASE / POSTGRESQL DATABASE
# ==============================================================================
DATABASE_URL=postgresql://user:password@host:port/dbname
