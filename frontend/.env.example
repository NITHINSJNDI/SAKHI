NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Comma-separated Gemini API keys for automated rotation and quota pooling
GEMINI_API_KEYS=your_first_gemini_key,your_second_gemini_key
NEXT_PUBLIC_ML_BACKEND_URL=http://127.0.0.1:8000

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# PostgreSQL Database (Supabase / Neon / Local)
DATABASE_URL=postgresql://user:password@host:port/dbname
