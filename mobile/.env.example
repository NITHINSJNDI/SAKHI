# Public base URL for the existing SAKHI Next.js API.
# Use a reachable HTTPS host. Do not use http://localhost from a physical device.
EXPO_PUBLIC_API_URL=https://your-sakhi-domain.example

# Google Sign-In (needs a development/store build, not Expo Go).
# Web client = the same GOOGLE_CLIENT_ID the website uses on Vercel.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
