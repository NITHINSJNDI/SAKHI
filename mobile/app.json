{
  "expo": {
    "name": "SAKHI",
    "slug": "sakhi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "sakhi",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sakhi.health",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Sakhi uses the camera so you can photograph lab reports.",
        "NSPhotoLibraryUsageDescription": "Sakhi lets you pick a lab report photo from your gallery."
      }
    },
    "android": {
      "package": "com.sakhi.health",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#FBF6F3"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/sakhi-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6F3",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#1D0F22",
            "image": "./assets/images/splash-logo.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7B4F8E"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "082ee139-2e20-4b6b-a5f2-af7cbbd543d3"
      }
    }
  }
}
